  "full_recipe": {
    "minimum_level": 3,
    "passes": [
      "07",
      "10",
      "11",
      "14"
    ],
    "obligations": {
      "V21": [
        "ci-test"
      ],
      "V09": [
        "ci-test"
      ],
      "V07": [
        "ci-replay"
      ]
    },
    "independent_review": true
  },
  "rules": [
    {
      "_note": "Prose only. The cheapest route the policy offers, and the one to read hardest before approving.",
      "id": "docs-only",
      "review_status": "proposed",
      "match": {
        "surfaces": [
          "docs"
        ],
        "effects": [
          "prose"
        ]
      },
      "requires": {
        "passes": [
          "06"
        ],
        "minimum_level": 0
      },
      "obligations": {
        "V09": [
          "ci-test"
        ]
      }
    },
    {
      "id": "product-code",
      "review_status": "proposed",
      "match": {
        "surfaces": [
          "product"
        ]
      },
      "requires": {
        "passes": [
          "10",
          "11"
        ],
        "minimum_level": 2
      },
      "obligations": {
        "V21": [
          "ci-test"
        ],
        "V07": [
          "ci-replay"
        ]
      }
    },
    {
      "id": "schema-contract",
      "review_status": "proposed",
      "match": {
        "surfaces": [
          "schema"
        ]
      },
      "requires": {
        "passes": [
          "10",
          "11"
        ],
        "minimum_level": 2
      },
      "obligations": {
        "V07": [
          "ci-replay"
        ],
        "V21": [
          "ci-test"
        ]
      }
    },
    {
      "_note": "The self-grading rule. A change to what verifies the repository cannot be judged by a route that change could have weakened, so it forces the full recipe and independent review.",
      "id": "verification-authority",
      "review_status": "proposed",
      "match": {
        "effects": [
          "verification-authority"
        ]
      },
      "requires": {
        "passes": [
          "07",
          "14"
        ],
        "minimum_level": 3,
        "force_full": true,
        "independent_review": true
      },
      "obligations": {
        "V21": [
          "ci-test"
        ],
        "V07": [
          "ci-replay"
        ]
      }
    },
    {
      "id": "skill-policy",
      "review_status": "proposed",
      "match": {
        "surfaces": [
          "skill-policy"
        ]
      },
      "requires": {
        "passes": [
          "07"
        ],
        "minimum_level": 3,
        "force_full": true,
        "independent_review": true
      },
      "obligations": {
        "V09": [
          "ci-test"
        ]
      }
    },
    {
      "_note": "A mode change can turn data into a program without altering a byte of content, so it never takes a content-shaped route.",
      "id": "mode-change",
      "review_status": "proposed",
      "match": {
        "mode_changed": true
      },
      "requires": {
        "passes": [
          "04",
          "10"
        ],
        "minimum_level": 2
      },
      "obligations": {
        "V09": [
          "ci-test"
        ]
      }
    }
  ]
